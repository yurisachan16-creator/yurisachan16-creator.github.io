{
  "name": "hexo-site",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yurisachan16-creator/yurisachan16-creator.github.io.git"
  },
  "scripts": {
    "build": "hexo generate && node tools/prune-public-assets.mjs",
    "clean": "hexo clean",
    "deploy": "npm run build && wrangler deploy",
    "server": "hexo server",
    "sync-themes": "node tools/sync-themes.mjs",
    "postinstall": "npm run sync-themes",
    "doc:requirements": "node tools/write-requirements-xlsx.mjs",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:migrate": "npm --prefix worker run migrate:remote",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "verify": "npm run test:unit && npm run worker:typecheck && npm run build",
    "release:dry-run": "sh -c 'tmp_dir=$(mktemp -d); trap \"rm -rf \\\"$tmp_dir\\\"\" EXIT; git clone . \"$tmp_dir\" >/dev/null 2>&1; (cd \"$tmp_dir\" && git checkout -B main >/dev/null 2>&1 && git update-ref refs/remotes/origin/main HEAD); npx -y release-please release-pr --dry-run --local --local-path \"$tmp_dir\" --target-branch main --repo-url yurisachan16-creator/yurisachan16-creator.github.io --release-type node --config-file .github/release-please-config.json'",
    "preview": "npm run build && wrangler dev"
  },
  "hexo": {
    "version": "8.1.1"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-theme-butterfly": "^5.5.4",
    "hexo-wordcount": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "exceljs": "^4.4.0",
    "jsdom": "^24.0.0",
    "vitest": "^1.3.0",
    "wrangler": "^4.95.0"
  }
}
